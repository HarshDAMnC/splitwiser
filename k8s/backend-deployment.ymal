apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend-deployment
  labels:
    app: backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: backend
  template:
    metadata:
      labels:
        app: backend
    spec:
      containers:
        - name: backend
          image: harshs3185/splitwiser-backend:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 5000
          # Load Supabase credentials from a Secret created from backend/.env (see instructions)
          envFrom:
            - secretRef:
                name: supabase-env
